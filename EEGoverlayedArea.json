{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 720,
  "height": 350,
  "config":{ "font":"Gelasio, serif"},
  "title": "Healthy vs Alzheimer's patient brain waves distribution",
  "data": {
    "url": "combined_frequency_power.csv"
  },

  "params": [
    {
      "name": "ChannelSelect",
      "value": "T3",
      "bind": {
        "input": "select",
        "options": ["T3","T4","T5","T6","P3","P4","Pz","F3","F4","Fz","O1","O2"],
        "name": "Brain Region: "
      }
    }
  ],

  "transform": [{"filter": "datum.channel == ChannelSelect"}],

  "mark": {
    "type": "area",
    "opacity": 0.75,
    "line": true
  },

  "encoding": {
    "x": {
      "field": "frequency",
      "type": "quantitative",
      "title": "Brain Wave Frequency (Hz)"
      
    },

    "y": {
      "field": "log_power",
      "type": "quantitative",
      "title": "Power (log)",
      "scale": {"domain":[-13,-7.5]}
    },
    "color": {
      "field": "patient",
      "title":"Patient",
      "type": "nominal",
      "scale": {"range": ["rgb(112, 245, 29)", "rgb(12, 38, 130)"]},
      "legend":{"orient":"right"}
    }
  }
}