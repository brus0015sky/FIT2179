{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 330,
  "config":{ "font":"Gelasio, serif"},
  "title": "Screen time per week vs Naplan results by state",
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "aus_alt.topojson",
        "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
      },
      "mark": {
        "type": "geoshape",
        "fill":"lightgray",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "combinedMapData.csv"
      },
      
      "mark": {"type": "circle", "tooltip": {"content": "data"},"stroke":"black","strokeWidth":2.0},
      "encoding": {
        
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "naplan",
          "type": "quantitative",
          "title": "Avg. Naplan results",
          "scale": {"domain": [550, 580]}
        },
        "color": {
          "field": "hoursScrolled",
          "type": "quantitative",
          "title": "Avg. Hours scrolled",
          "scale": {"scheme": "lightgreyteal","domain": [12.5,14.5]}
        },
        "tooltip": [
      { "field": "naplan", "title": "Avg. Naplan Score" },
      { "field": "hoursScrolled", "title": "Avg. Hours scrolled per week","format":".2f" }
    ]
      }
    }
  ]
}